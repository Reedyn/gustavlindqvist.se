---json
{
  "permalink": "ghost-tags.json",
  "eleventyExcludeFromCollections": true
}
---
{
	"meta": {
		"exported_on": {% epoch %},
		"version": "6.0.0"
	},
	"data": {
		"tags": [
			{% for tag, count in collections.tagsBySize %} {% if (tag !== 'posts') and (tag !== 'page') %}{% set tagUrl %}/{{ tag | slug }}/{% endset %}{% set tagData = tagMetadata[tag] %}
			{
				"id":   "{{ tag | hashString }}",
				"name": "{% if tagData.title %}{{ tagData.title | firstLetterUppercase }}{% else %}{{ tag | firstLetterUppercase }}{% endif %}",
				"slug": "{{ tag }}"
			}{% if loop.index0 < collections.tagsBySize.length %},{% endif %}
			{% endif %} {% endfor %}
		]
	}
}